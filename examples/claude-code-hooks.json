{
  "_comment": "Merge these into the \"hooks\" object of ~/.claude/settings.json.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/hooks/claude-border.sh\" paint", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/hooks/claude-border.sh\" solid", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/hooks/claude-border.sh\" blink", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/hooks/claude-border.sh\" blink", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/hooks/claude-border.sh\" clear", "timeout": 5 } ] }
    ]
  }
}
